// Uudam Travel Agency — booking platform schema.
//
// Business model note, because it shapes everything below. The agency began
// selling entirely by hand: the site was a catalogue plus lead capture, a
// visitor sent an Enquiry and staff rang them back. In September 2026 the
// client decided to sell online as well, which is where Booking, Traveler
// and Payment come from.
//
// Both paths are live and neither replaces the other. Most customers here
// still want a person on the phone, so Enquiry is not deprecated.
//
// Two things this app still does NOT do, deliberately:
//   * It never takes money. Payment records a bank transfer that staff
//     confirm by hand. QPay slots in behind the same model once the agency
//     holds a merchant account.
//   * There are no customer accounts. A booking is found by its reference,
//     not by signing in — there is no SMS gateway wired up for phone OTP,
//     and email-only accounts were not worth the friction.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// Staff accounts only. Customers never sign in.
model User {
  id               String    @id @default(uuid())
  email            String    @unique
  password         String?
  phonenumber      String?
  role             Role      @default(ADMIN)
  isVerified       Boolean   @default(false)
  resetToken       String?
  resetTokenExpiry DateTime?
  firstName        String?
  lastName         String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  handledEnquiries Enquiry[]
  handledBookings  Booking[]

  @@index([role])
}

model Trip {
  id      String  @id @default(uuid())
  slug    String  @unique
  title   String
  summary String?

  /// Long-form sell copy shown on the trip page.
  description String

  // ---- Where ----------------------------------------------------------------
  country      String?
  city         String?
  region       String?
  destinations String[] @default([])
  meetingPoint String?
  latitude     Float?
  longitude    Float?
  mapUrl       String?

  // ---- Trip facts -----------------------------------------------------------
  durationDays   Int        @default(1)
  durationNights Int        @default(0)
  minTravelers   Int        @default(1)
  maxTravelers   Int?
  difficulty     Difficulty @default(EASY)
  transport      String[]   @default([])
  languages      String[]   @default([])
  season         String?

  // ---- Sell copy ------------------------------------------------------------
  highlights         String[] @default([])
  included           String[] @default([])
  excluded           String[] @default([])
  requirements       String?
  cancellationPolicy String?
  importantNotes     String[] @default([])

  // ---- Media ----------------------------------------------------------------
  image       String
  extraImages String[] @default([])
  video       String?
  videos      String[] @default([])

  // ---- Pricing (indicative; staff quote the final figure on the phone) ------
  price            Float
  oldPrice         Float?
  discount         Int?    @default(0)
  childPrice       Float?
  infantPrice      Float?
  singleSupplement Float?
  currency         String  @default("MNT")

  // ---- Chatbot import facts --------------------------------------------------
  /// Original source row id from the Messenger chatbot travel database.
  sourceTripId    String?  @unique
  sourceMetadata  Json?
  hotel           String?
  foodIncluded    Boolean?
  departureRule   String?
  extraFees       String[] @default([])
  roomPrices      String[] @default([])
  childPriceNotes String[] @default([])
  brochurePdfUrl  String?

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  /// Free-form, admin-authored labels ("Галт тэрэг", "Хосолсон аялал" …) —
  /// unlike Category (one tree, one slot per trip) a trip can carry any
  /// number of these, and staff create the tags themselves. Nothing is
  /// pre-seeded.
  tags Tag[] @relation("TripTags")

  isFeatured  Boolean @default(true)
  isPublished Boolean @default(true)
  /// Manually maintained by staff — there is no automatic sales counter.
  salesCount  Int     @default(0)
  avgRating   Float   @default(0)
  reviewCount Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  itinerary    ItineraryDay[]
  departures   Departure[]
  enquiries    Enquiry[]
  bookings     Booking[]
  testimonials Testimonial[]
  views        TripView[]

  @@index([categoryId])
  @@index([createdAt])
  @@index([isPublished, isFeatured])
  @@index([sourceTripId])
}

/// A dated instance of a trip. Seat counts are maintained by staff, not
/// decremented automatically, because bookings are confirmed off-site.
model Departure {
  id     String  @id @default(uuid())
  tripId String
  label  String?

  startDate DateTime
  endDate   DateTime?

  seatsTotal Int?
  seatsLeft  Int?

  price       Float?
  childPrice  Float?
  infantPrice Float?

  status DepartureStatus @default(OPEN)

  trip      Trip      @relation(fields: [tripId], references: [id], onDelete: Cascade)
  enquiries Enquiry[]
  bookings  Booking[]

  @@index([tripId])
  @@index([startDate])
  @@index([tripId, startDate])
}

model ItineraryDay {
  id        String @id @default(uuid())
  tripId    String
  dayNumber Int
  title     String

  description   String?
  location      String?
  meals         String[] @default([])
  accommodation String?
  image         String?
  /// Cloudinary URL. Uploaded the same signed, direct-to-Cloudinary way as
  /// trip-level video, since day clips hit the same 4.5MB Vercel body ceiling.
  video         String?

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@unique([tripId, dayNumber])
  @@index([tripId])
}

model Category {
  id           String  @id @default(uuid())
  categoryName String
  slug         String? @unique
  description  String?
  image        String?

  parentId String?
  parent   Category?  @relation("CategoryChildren", fields: [parentId], references: [id])
  children Category[] @relation("CategoryChildren")

  trips Trip[]

  @@index([parentId])
}

/// Free-form categorisation staff define themselves — "Галт тэрэг", "Хосолсон",
/// anything. Starts empty; nothing is pre-seeded. A trip can carry any number
/// of these, unlike Category which is one tree with one slot per trip.
model Tag {
  id   String @id @default(uuid())
  name String
  slug String @unique

  trips Trip[] @relation("TripTags")

  createdAt DateTime @default(now())

  @@index([name])
}

/// A named, admin-authored price range ("0–1 сая", "2 сая+"). Deliberately
/// has no relation to Trip: membership is computed live from `Trip.price` at
/// read time, so a band never goes stale when staff edit a trip's price —
/// the alternative (stamping a band id onto each trip) would silently lie
/// the moment the price changes.
model PriceBand {
  id        String  @id @default(uuid())
  name      String
  minPrice  Float   @default(0)
  /// Null means no upper bound ("2 сая+").
  maxPrice  Float?
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
}

/// A "call me back" request. This is the site's only conversion event.
model Enquiry {
  id        String @id @default(uuid())
  /// Short human-quotable code, so staff can say "your request UUD-7K2Q9".
  reference String @unique

  /// Which form this came from. TRIP keeps the original behaviour, so every
  /// existing row is correct without a backfill.
  kind EnquiryKind @default(TRIP)

  tripId        String?
  departureId   String?
  departureDate DateTime?

  // ---- CUSTOM (private / group request) -------------------------------------
  /// Free text: the catalogue can't cover everywhere people ask to go.
  destination String?
  /// Also free text — "10-р сарын дунд" and "уян хатан" are both real answers,
  /// and forcing a date picker loses the flexibility staff need to sell into.
  preferredDates String?
  budgetPerPerson Float?

  // ---- GIFT (gift certificate request) --------------------------------------
  giftAmount    Float?
  giftRecipient String?

  firstName String
  phone     String
  lastName  String?
  email     String?

  adults   Int @default(1)
  children Int @default(0)
  infants  Int @default(0)

  message String?

  /// Indicative total from the published fares at the time of the enquiry —
  /// a starting point for the call, never a quote.
  estimatedTotal Float?

  status     EnquiryStatus @default(NEW)
  staffNotes String?

  handledById String?
  handledBy   User?   @relation(fields: [handledById], references: [id])

  /// Where the visitor came from, so staff know which post is working.
  source String?
  /// Anonymous visitor id, links this lead back to its TripView rows.
  visitorId String?
  referrer  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  trip      Trip?      @relation(fields: [tripId], references: [id], onDelete: SetNull)
  departure Departure? @relation(fields: [departureId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([tripId])
  @@index([createdAt])
  @@index([visitorId])
}

/// An actual online booking, as opposed to an Enquiry (which is only a
/// request for a call back).
///
/// The agency historically sold entirely by phone; this exists because the
/// client decided to sell online as well. Both paths stay live — a visitor
/// can still just ask staff to ring them — so nothing here replaces Enquiry.
///
/// Money is never taken by this app. `Payment` records a bank transfer that
/// staff confirm by hand; a card/QPay provider slots in behind the same
/// model once the agency holds a merchant account.
model Booking {
  id String @id @default(uuid())
  /// Human-quotable, same alphabet as an enquiry reference: "UUD-B-7K2Q9".
  reference String @unique

  tripId      String
  departureId String

  status BookingStatus @default(HELD)

  adults   Int @default(1)
  children Int @default(0)
  infants  Int @default(0)

  firstName String
  lastName  String?
  phone     String
  email     String?
  notes     String?

  /// Snapshotted at booking time, never recomputed. If staff edit the trip's
  /// price next week, what this customer agreed to must not silently change.
  totalPrice Float
  /// What the customer must transfer now to hold the seats. Null means the
  /// full amount is due.
  depositDue Float?
  paidAmount Float  @default(0)
  currency   String @default("MNT")

  /// While a booking is HELD its seats are reserved but unpaid. Past this
  /// moment a sweep releases them, so an abandoned checkout can't hold a seat
  /// out of sale forever.
  holdExpiresAt DateTime?

  /// Who processed it, once staff pick it up.
  handledById String?
  handledBy   User?   @relation(fields: [handledById], references: [id])

  source    String?
  visitorId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  trip      Trip      @relation(fields: [tripId], references: [id])
  departure Departure @relation(fields: [departureId], references: [id])

  travelers Traveler[]
  payments  Payment[]

  @@index([status, createdAt])
  @@index([departureId, status])
  @@index([createdAt])
}

/// One person on a booking. Passport fields are deliberately optional and
/// collected after the seat is held, not before: asking for a passport number
/// to see a price is how you lose the booking.
model Traveler {
  id        String @id @default(uuid())
  bookingId String

  firstName String
  lastName  String?
  type      TravelerType @default(ADULT)

  dateOfBirth DateTime?
  nationality String?

  /// Identity data. Stored because the agency needs it to issue tickets, and
  /// nothing more is kept than that requires.
  passportNumber String?
  passportExpiry DateTime?

  notes String?

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
}

/// A transfer against a booking. Staff confirm bank transfers by hand today;
/// `provider`/`providerRef` exist so an automated provider can be recorded
/// the same way without a second model.
model Payment {
  id        String @id @default(uuid())
  bookingId String

  method PaymentMethod @default(BANK)
  status PaymentStatus @default(PENDING)
  amount Float

  /// What the customer should write on the transfer, and what staff match
  /// against the bank statement.
  reference   String
  provider    String?
  providerRef String?

  paidAt      DateTime?
  confirmedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@index([status])
}

/// Customer feedback, entered by staff. There are no customer accounts, so
/// these can't be self-service reviews.
model Testimonial {
  id         String   @id @default(uuid())
  tripId     String?
  authorName String
  rating     Int      @default(5)
  comment    String
  images     String[] @default([])
  travelDate DateTime?

  isPublished Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  trip Trip? @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId])
  @@index([isPublished])
}


/// Single-row site-wide settings. A fixed id rather than a real primary key
/// sequence, because there is exactly one row and it is fetched by that
/// known id, never queried or listed.
model SiteSettings {
  id String @id @default("default")

  /// Shown on every trip page — a standing disclaimer or policy note the
  /// client wants repeated everywhere ("бид хариуцлага хүлээхгүй" etc.)
  /// without retyping it into every trip. A trip's own `Trip.importantNotes[]`
  /// still exists for anything specific to that one trip; the two render
  /// together, this one first.
  tripNotice String?

  /// Where a customer sends a bank transfer, free text so the client can
  /// write it the way her bank actually words it (bank, account number,
  /// account name). Editable in admin, never in code — she changes banks
  /// and account names without a developer.
  bankDetails String?

  updatedAt DateTime @updatedAt
}

/// A funnel signal that isn't a full Enquiry: a share tap, a save toggle, a
/// phone/Messenger click, a departure being picked before the form is ever
/// submitted. TripView already answers "views vs. enquiries" by itself — this
/// fills the gap between the two, which is currently invisible: whether the
/// page is being used at all before someone decides not to enquire.
model AnalyticsEvent {
  id   String @id @default(uuid())
  name String

  tripId    String?
  visitorId String
  sessionId String

  /// Small, event-specific extras — e.g. { channel: "messenger" } for a share,
  /// { departureId } for a departure pick. Never anything identifying.
  properties Json?

  createdAt DateTime @default(now())

  @@index([name, createdAt])
  @@index([tripId, name])
}

/// A travel guide or news article. Staff-authored in the admin; there is no
/// external CMS, because everything the client edits has to live in one place.
model Post {
  id      String  @id @default(uuid())
  slug    String  @unique
  title   String
  excerpt String?

  /// Markdown-ish plain text. Deliberately not a rich-text blob: the client is
  /// non-technical and a broken WYSIWYG payload is unrecoverable for her.
  body String

  coverImage String?

  /// Unlike Trip, this defaults to false. Publishing 24 of 25 trips by accident
  /// was survivable; publishing a half-written article is not.
  isPublished Boolean   @default(false)
  publishedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isPublished, publishedAt])
}

/// One page view. First-party analytics — no third-party script, and nothing
/// personally identifying: `visitorId` is a random id the browser generates for
/// itself, never an IP or a fingerprint.
///
/// Rows are kept raw rather than pre-aggregated. At an agency's traffic that is
/// far cheaper than maintaining rollups, and it keeps every question askable
/// after the fact. Add a daily rollup if this ever passes a few million rows.
model TripView {
  id     String  @id @default(uuid())
  tripId String?
  path   String

  visitorId String
  sessionId String

  referrer String?
  source   String?
  device   String?

  /// Time on page, filled in by a beacon when the visitor leaves. 0 means they
  /// left before it fired — a bounce, or a browser that dropped the beacon.
  durationMs Int @default(0)
  videoPlays Int @default(0)

  createdAt DateTime @default(now())

  trip Trip? @relation(fields: [tripId], references: [id], onDelete: SetNull)

  @@index([tripId, createdAt])
  @@index([createdAt])
  @@index([visitorId])
  @@index([tripId, visitorId])
}

enum Role {
  ADMIN
  STAFF
}

enum Difficulty {
  EASY
  MODERATE
  CHALLENGING
}

enum DepartureStatus {
  OPEN
  ALMOST_FULL
  SOLD_OUT
  CANCELLED
  DEPARTED
}

enum EnquiryStatus {
  NEW
  CONTACTED
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum BookingStatus {
  /// Seats reserved, nothing paid. Expires — see Booking.holdExpiresAt.
  HELD
  /// Customer has been given transfer instructions.
  PENDING_PAYMENT
  /// Deposit received, balance outstanding.
  PARTIALLY_PAID
  /// Paid in full and confirmed by staff.
  CONFIRMED
  /// Travelled.
  COMPLETED
  CANCELLED
  /// The hold ran out before payment arrived; seats went back on sale.
  EXPIRED
}

enum TravelerType {
  ADULT
  CHILD
  INFANT
}

enum PaymentMethod {
  BANK
  QPAY
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum EnquiryKind {
  /// About a specific trip in the catalogue.
  TRIP
  /// "The dates don't work" — a private or custom group request.
  CUSTOM
  /// A gift certificate request. Staff arrange payment off-site.
  GIFT
}
