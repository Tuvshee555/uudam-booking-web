# ════════════════════════════════════════════════════════════════════════════
# CHANGE THESE TWO PER DEPLOYMENT — everything else can be copied as-is
# ════════════════════════════════════════════════════════════════════════════

# Neon. DATABASE_URL must be the POOLED string (host contains "-pooler"):
# serverless opens a connection per instance and would exhaust a direct pool.
DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/db?sslmode=require"
# Direct string — used by `prisma migrate` only.
DIRECT_URL="postgresql://user:pass@ep-xxx.region.aws.neon.tech/db?sslmode=require"

# Used for password-reset links and canonical URLs.
NEXT_PUBLIC_SITE_URL="https://uudam.mn"


# ════════════════════════════════════════════════════════════════════════════
# AGENCY CONTACT — this is the conversion path, so fill it in properly.
# All of it is read in src/lib/contact.ts.
# ════════════════════════════════════════════════════════════════════════════

NEXT_PUBLIC_PHONE="+976 9911 2233"
NEXT_PUBLIC_EMAIL="info@uudam.mn"

# The Facebook page and its Messenger deep link (usually m.me/<page-handle>).
# Buttons for these stay hidden until a real URL is set.
NEXT_PUBLIC_FACEBOOK_PAGE=""
NEXT_PUBLIC_MESSENGER_URL=""
NEXT_PUBLIC_INSTAGRAM=""

NEXT_PUBLIC_ADDRESS="Улаанбаатар, Монгол"
NEXT_PUBLIC_WORKING_HOURS="Даваа–Баасан 09:00–18:00"


# ════════════════════════════════════════════════════════════════════════════
# SHARED — same values as the other projects, no need to re-create anything
# ════════════════════════════════════════════════════════════════════════════

# Any long random string. Only staff log in, but this signs their sessions.
JWT_SECRET=""

# Trip photos and videos.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Email. Used for two things only: the "we got your request" note to the
# customer, and a heads-up to the office. Leave blank and the site still
# works — enquiries just land in the admin panel silently.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Uudam Travel <info@uudam.mn>"

# Where new-enquiry alerts go. Defaults to SMTP_USER if unset.
ENQUIRY_NOTIFY_EMAIL=""


# ════════════════════════════════════════════════════════════════════════════
# OPTIONAL
# ════════════════════════════════════════════════════════════════════════════

# AI trip advisor. Without a key it still answers, using catalog search only.
GEMINI_API_KEY=""
GEN_MODEL="gemini-2.5-flash"

# The API lives inside this app. Leave empty unless you are deliberately
# pointing the frontend at a different deployment.
NEXT_PUBLIC_BACKEND_URL=""

# Only read by prisma/seed.mjs.
SEED_ADMIN_EMAIL="admin@uudam.mn"
SEED_ADMIN_PASSWORD=""

# QPay merchant API (merchant.qpay.mn/v2) — online booking payment. Without
# these, the "QPay-аар төлөх" button on a booking's confirmation screen
# 503s; bank-transfer booking still works with no QPay account at all.
QPAY_BASE_URL=""
QPAY_USERNAME=""
QPAY_PASSWORD=""
QPAY_INVOICE_CODE=""
